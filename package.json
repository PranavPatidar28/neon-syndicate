{
  "name": "neon-syndicate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @neon/web test:e2e && pnpm --filter @neon/mission-control test:e2e",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm quest:validate",
    "infra:docker:up": "docker compose --profile local-fallback up -d --wait",
    "infra:docker:down": "docker compose --profile local-fallback down",
    "db:generate": "pnpm --filter @neon/database generate",
    "db:validate": "pnpm --filter @neon/database validate",
    "db:migrate": "pnpm --filter @neon/database migrate",
    "db:seed": "pnpm --filter @neon/database seed",
    "redis:check": "pnpm --filter @neon/worker redis:check",
    "quest:list": "pnpm --filter @neon/challenge-engine quest list",
    "quest:status": "pnpm --filter @neon/challenge-engine quest status",
    "quest:start": "pnpm --filter @neon/challenge-engine quest start",
    "quest:check": "pnpm --filter @neon/challenge-engine quest check",
    "quest:complete": "pnpm --filter @neon/challenge-engine quest complete",
    "quest:validate": "pnpm --filter @neon/challenge-engine quest validate",
    "mission-control": "pnpm --filter @neon/mission-control dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.3",
    "@types/node": "24.10.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.9.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml,css}": "prettier --check"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.1",
      "file-type": "21.3.2",
      "js-yaml": "5.4.1",
      "lodash": "4.18.1",
      "multer": "2.3.0",
      "path-to-regexp": "8.4.2",
      "uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma"
    ]
  }
}
