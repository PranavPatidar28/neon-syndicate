NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Neon: use the pooled URL (hostname contains -pooler) for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon: use the direct URL (hostname has no -pooler) for Prisma migrations.
# You may temporarily use the same direct URL for both variables while setting up.
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional Docker fallback: after `pnpm infra:docker:up`, set both URLs to
# postgresql://neon:neon@localhost:5432/neon_syndicate?schema=public

# Managed Redis: paste the TLS Redis URL from Upstash or Redis Cloud.
# Use the Redis protocol URL (rediss://), not an HTTPS REST API URL.
REDIS_URL=rediss://default:PASSWORD@YOUR-ENDPOINT.upstash.io:6379
LOG_LEVEL=info

# Optional local Mission Control mentor proxy. The dashboard works while offline.
ANTIGRAVITY_BASE_URL=http://localhost:8080
ANTIGRAVITY_MENTOR_MODEL=gemini-3.6-flash-high
